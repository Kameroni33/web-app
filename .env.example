# Single env file for the whole stack. Copy to .env (gitignored).
# Compose uses it to fill in compose.yaml values (DB_*, TUNNEL_TOKEN, APP_PORT)
# and passes it as the environment for the Laravel containers.
# Generate APP_KEY with:  docker compose run --rm --no-deps app php artisan key:generate --show

APP_NAME="Personal Tools"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.network-kam.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Shared by the postgres service and Laravel. DB_HOST is set in compose.yaml.
DB_CONNECTION=pgsql
DB_DATABASE=laravel
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mail.network-kam.com"
MAIL_FROM_NAME="${APP_NAME}"

# Host port for local testing (bound to 127.0.0.1 only).
APP_PORT=23417

# Cloudflare Zero Trust → Networks → Tunnels → web-app → token
TUNNEL_TOKEN=
